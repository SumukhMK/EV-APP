# Copy to .env.local to run against a real API.
#
# The presence of this one variable is what switches the app from mocks to the
# live backend — see IS_LIVE in src/lib/api/client.ts. There is deliberately no
# second "use mocks" flag: two switches that must agree eventually disagree.
#
# Unset (the default, and what the test run and a plain `npm run dev` use):
#   every module serves fixtures, and login accepts any credentials.
#
# Set: auth and vehicles talk to the API. The modules with no backend yet
#   (riders, service, payments, assignments, users, audit) stay on fixtures
#   until their stage lands — see docs/backend/WORK_SPLIT.md.
VITE_API_BASE=http://localhost:8080/api/v1
